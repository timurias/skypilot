FROM node:20-alpine

# Установка Git (если нужен для каких-то npm-пакетов или скриптов)
RUN apk add --no-cache git

WORKDIR /app

# Копируем только файлы зависимостей для кэширования слоёв
COPY package*.json ./

# Устанавливаем зависимости (слой пересоберётся только при изменении package.json)
RUN npm install

# Копируем остальные файлы проекта (но они будут перезаписаны томом при запуске)
COPY . .

# Порт приложения (проверьте, что ваш dev-сервер действительно слушает 3000)
EXPOSE 9002

# Команда для разработки (обычно отслеживает изменения и перезапускается)
CMD ["npm", "run", "dev"]